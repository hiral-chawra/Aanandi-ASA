# ── Server & Port ────────────────────────────────────────────────────────
PORT=10000

# ── MongoDB Atlas Configuration (Required) ──────────────────────────────
# Ensure Network Access in MongoDB Atlas has 0.0.0.0/0 whitelisted for Render
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aanandi_sales?retryWrites=true&w=majority"
DATABASE_NAME="aanandi_sales"

# ── LLM Providers (Provide at least ONE: OpenRouter or OpenAI) ──────────
OPENROUTER_API_KEY="sk-or-v1-..."
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY=""

# ── Cal.com Scheduling Configuration ────────────────────────────────────
CAL_API_KEY="cal_live_..."
CAL_EVENT_TYPE_ID="7297448"
CAL_TIME_ZONE="Asia/Kolkata"

# ── Primary SMTP / Gmail App Password (for OTPs & confirmations) ────────
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_gmail_app_password"
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_FROM_EMAIL="your_email@gmail.com"

# ── Internal Notification Recipients ────────────────────────────────────
BOOKING_NOTIFICATION_EMAIL="pyashff0312@gmail.com"
RECEPTIONIST_EMAIL="pyashkumar0312@gmail.com"
TECH_TEAM_EMAIL="asmiupadhyay491@gmail.com"

# ── Razorpay Payment Gateway (Optional - Demo fallback active if empty) ──
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
